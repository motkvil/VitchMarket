{
  "rules": {
    ".read": false,
    ".write": false,
    "ranking": {
      ".read": true,
      ".indexOn": [
        "score"
      ],
      "$run": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'name', 'days', 'money', 'rep', 'staff', 'score', 'final', 'ts'])",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "days": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && (!data.exists() || newData.val() >= data.val())"
        },
        "money": {
          ".validate": "newData.isNumber()"
        },
        "rep": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "staff": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15"
        },
        "score": {
          ".validate": "newData.isNumber()"
        },
        "final": {
          ".validate": "newData.isBoolean()"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code === 'VITCH'",
        "info": {
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'name', 'dur', 'status'])",
          "host": {
            ".write": "auth != null && newData.val() === auth.uid && root.child('rooms/'+$code+'/members/'+auth.uid).exists() && now - data.parent().child('hb').val() > 120000",
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "dur": {
            ".validate": "newData.isNumber() && newData.val() >= 60 && newData.val() <= 43200"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "day": {
            ".validate": "newData.isNumber()"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "hb": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/'+$code+'/info/host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "role": {
              ".validate": "(newData.val() === 'jefe' && newData.parent().parent().parent().child('info/host').val() === auth.uid) || ((newData.val() === 'atc' || newData.val() === 'alm' || newData.val() === 'back' || newData.val() === 'rrpp' || newData.val() === 'rrhh') && (data.val() === newData.val() || newData.parent().parent().parent().child('info/host').val() === auth.uid))"
            },
            "on": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            },
            "apply": {
              ".validate": "newData.val() === 'atc' || newData.val() === 'alm' || newData.val() === 'back' || newData.val() === 'rrpp' || newData.val() === 'rrhh'"
            }
          }
        },
        "state": {
          ".write": "auth != null && root.child('rooms/'+$code+'/info/host').val() === auth.uid"
        },
        "meta": {
          ".write": "auth != null && root.child('rooms/'+$code+'/info/host').val() === auth.uid"
        },
        "notes": {
          "$uid": {
            ".write": "auth != null && root.child('rooms/'+$code+'/info/host').val() === auth.uid"
          }
        },
        "acts": {
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/'+$code+'/members/'+auth.uid).exists()) || (!newData.exists() && root.child('rooms/'+$code+'/info/host').val() === auth.uid))",
            ".validate": "newData.hasChildren(['uid', 'k', 'ts'])",
            "uid": {
              ".validate": "newData.isString()"
            },
            "k": {
              ".validate": "newData.val() === 'take' || newData.val() === 'done' || newData.val() === 'drop' || newData.val() === 'hire' || newData.val() === 'reject' || newData.val() === 'till'"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "sc": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "early": {
              ".validate": "newData.isBoolean()"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            },
            "u": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "d": {
              ".validate": "true"
            },
            "tk": {
              ".validate": "true"
            },
            "ret": {
              ".validate": "true"
            },
            "rev": {
              ".validate": "true"
            },
            "done": {
              ".validate": "true"
            }
          }
        },
        "till": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/'+$code+'/info/host').val() === auth.uid)"
          }
        }
      }
    }
  }
}
