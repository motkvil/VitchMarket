{
  "rules": {
    ".read": false,
    ".write": false,
    "ranking": {
      ".read": true,
      ".indexOn": [
        "score",
        "ts"
      ],
      "$run": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'name', 'days', 'money', 'rep', 'staff', 'score', 'final', 'ts'])",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "days": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && (!data.exists() || newData.val() >= data.val())"
        },
        "money": {
          ".validate": "newData.isNumber()"
        },
        "rep": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "staff": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 15"
        },
        "score": {
          ".validate": "newData.isNumber()"
        },
        "final": {
          ".validate": "newData.isBoolean()"
        },
        "ts": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "daily": {
      ".read": true,
      "$date": {
        ".indexOn": [
          "score"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && $date.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/)",
          ".validate": "newData.hasChildren(['name', 'score', 'stars', 'served', 'ts'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() > -100000000 && newData.val() < 100000000"
          },
          "stars": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          },
          "served": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "ts": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code === 'VITCH'",
        "info": {
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'name', 'dur', 'status'])",
          "host": {
            ".write": "auth != null && newData.val() === auth.uid && root.child('rooms/'+$code+'/members/'+auth.uid).exists() && now - data.parent().child('hb').val() > 120000",
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "dur": {
            ".validate": "newData.isNumber() && newData.val() >= 60 && newData.val() <= 43200"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "day": {
            ".validate": "newData.isNumber()"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "hb": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "ret": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/'+$code+'/info/host').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "role": {
              ".validate": "(newData.val() === 'jefe' && newData.parent().parent().parent().child('info/host').val() === auth.uid) || ((newData.val() === 'atc' || newData.val() === 'alm' || newData.val() === 'back' || newData.val() === 'rrpp' || newData.val() === 'rrhh') && (data.val() === newData.val() || newData.parent().parent().parent().child('info/host').val() === auth.uid))"
            },
            "on": {
              ".validate": "newData.isBoolean()"
            },
            "av": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-5]\\.[0-3]\\.[0-6]$/)"
            },
            "$other": {
              ".validate": false
            },
            "apply": {
              ".validate": "newData.val() === 'atc' || newData.val() === 'alm' || newData.val() === 'back' || newData.val() === 'rrpp' || newData.val() === 'rrhh'"
            },
            "ct": {
              ".validate": "newData.val() === now"
            }
          }
        },
        "state": {
          ".write": "auth != null && (root.child('rooms/'+$code+'/info/host').val() === auth.uid || (root.child('rooms/'+$code+'/relay/uid').val() === auth.uid && now - root.child('rooms/'+$code+'/info/hb').val() > 20000))"
        },
        "meta": {
          ".write": "auth != null && (root.child('rooms/'+$code+'/info/host').val() === auth.uid || (root.child('rooms/'+$code+'/relay/uid').val() === auth.uid && now - root.child('rooms/'+$code+'/info/hb').val() > 20000))"
        },
        "notes": {
          "$uid": {
            ".write": "auth != null && (root.child('rooms/'+$code+'/info/host').val() === auth.uid || (root.child('rooms/'+$code+'/relay/uid').val() === auth.uid && now - root.child('rooms/'+$code+'/info/hb').val() > 20000))"
          }
        },
        "relay": {
          ".write": "auth != null && (root.child('rooms/'+$code+'/info/host').val() === auth.uid || (!newData.exists() && data.child('uid').val() === auth.uid) || (newData.child('uid').val() === auth.uid && root.child('rooms/'+$code+'/members/'+auth.uid+'/role').exists() && now - root.child('rooms/'+$code+'/info/hb').val() > 20000 && (!data.exists() || data.child('uid').val() === auth.uid || now - data.child('hb').val() > 20000)))",
          ".validate": "!newData.exists() || newData.hasChildren(['uid', 'hb'])",
          "uid": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "hb": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "since": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        },
        "acts": {
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/'+$code+'/members/'+auth.uid).exists()) || (!newData.exists() && (root.child('rooms/'+$code+'/info/host').val() === auth.uid || (root.child('rooms/'+$code+'/relay/uid').val() === auth.uid && now - root.child('rooms/'+$code+'/info/hb').val() > 20000))))",
            ".validate": "newData.hasChildren(['uid', 'k', 'ts'])",
            "uid": {
              ".validate": "newData.isString()"
            },
            "k": {
              ".validate": "newData.val() === 'take' || newData.val() === 'done' || newData.val() === 'drop' || newData.val() === 'hire' || newData.val() === 'reject' || newData.val() === 'till' || newData.val() === 'soc'"
            },
            "t": {
              ".validate": "newData.isNumber()"
            },
            "sc": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "early": {
              ".validate": "newData.isBoolean()"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            },
            "u": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            },
            "d": {
              ".validate": "true"
            },
            "tk": {
              ".validate": "true"
            },
            "ret": {
              ".validate": "true"
            },
            "rev": {
              ".validate": "true"
            },
            "done": {
              ".validate": "true"
            },
            "x": {
              ".validate": "true"
            },
            "a": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "e": {
              ".validate": "newData.isNumber()"
            },
            "r": {
              ".validate": "newData.isNumber()"
            },
            "o": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            }
          }
        },
        "chat": {
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms/'+$code+'/members/'+auth.uid+'/role').exists() && newData.parent().parent().child('members/'+auth.uid+'/ct').val() === now && (!root.child('rooms/'+$code+'/members/'+auth.uid+'/ct').exists() || now - root.child('rooms/'+$code+'/members/'+auth.uid+'/ct').val() > 3000)) || (!newData.exists() && (root.child('rooms/'+$code+'/info/host').val() === auth.uid || (root.child('rooms/'+$code+'/relay/uid').val() === auth.uid && now - root.child('rooms/'+$code+'/info/hb').val() > 20000))))",
            ".validate": "!newData.exists() || ($id.matches(/^c[0-9]+[a-z0-9]+$/) && newData.hasChildren(['uid', 'n', 't', 'ts']))",
            "uid": { ".validate": "newData.val() === auth.uid" },
            "n": { ".validate": "newData.isString() && newData.val() === root.child('rooms/'+$code+'/members/'+auth.uid+'/name').val()" },
            "t": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140 && !newData.val().matches(/https?:/i) && !newData.val().matches(/www[.]/i) && !newData.val().matches(/[.]com/i) && !newData.val().matches(/[.]net/i) && !newData.val().matches(/[.]org/i) && !newData.val().matches(/[.]es[/]/i)" },
            "ts": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },
        "guard": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && root.child('rooms/'+$code+'/members/'+auth.uid+'/role').exists() && root.child('rooms/'+$code+'/info/host').val() !== auth.uid) || (!newData.exists() && (root.child('rooms/'+$code+'/info/host').val() === auth.uid || (root.child('rooms/'+$code+'/relay/uid').val() === auth.uid && now - root.child('rooms/'+$code+'/info/hb').val() > 20000))))",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'role', 'ts', 'items'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "role": { ".validate": "newData.val() === 'atc' || newData.val() === 'alm' || newData.val() === 'back' || newData.val() === 'rrpp' || newData.val() === 'rrhh'" },
            "day": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000" },
            "ts": { ".validate": "newData.val() === now" },
            "fin": { ".validate": "newData.isBoolean()" },
            "items": {
              "$i": {
                ".validate": "$i.matches(/^[0-7]$/) && newData.hasChildren(['k', 'sc'])",
                "k": { ".validate": "newData.val() === 'truck' || newData.val() === 'repo' || newData.val() === 'inv' || newData.val() === 'spill' || newData.val() === 'cash' || newData.val() === 'tk' || newData.val() === 'cv'" },
                "sc": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
                "pid": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
                "d": { ".validate": "newData.val() === 'back' || newData.val() === 'rrpp' || newData.val() === 'alm'" },
                "c": {
                  ".validate": "newData.hasChildren(['name', 'role'])",
                  "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
                  "face": { ".validate": "newData.isString() && newData.val().length <= 8" },
                  "role": { ".validate": "newData.val() === 'atc' || newData.val() === 'alm' || newData.val() === 'back' || newData.val() === 'rrpp' || newData.val() === 'rrhh'" },
                  "rap": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
                  "trato": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
                  "punt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
                  "act": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
                  "nat": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" },
                  "$other": { ".validate": false }
                },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "till": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/'+$code+'/info/host').val() === auth.uid || (root.child('rooms/'+$code+'/relay/uid').val() === auth.uid && now - root.child('rooms/'+$code+'/info/hb').val() > 20000))"
          }
        }
      }
    }
  }
}
